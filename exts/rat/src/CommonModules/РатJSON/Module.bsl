#Область ПрограммныйИнтерфейс

// Преобразует значение в строку JSON.
//
// Параметры:
//   Объект - Произвольный - Объект, данные которого нужно преобразовать в JSON.
//   Параметры - Структура, Неопределено - Настройки преобразования:
//     + БезПреобразования - Булево - Не выполнять предварительную сериализацию значения.
//
// Возвращаемое значение:
//   Строка - Значение в JSON.
//
// Пример:
//   СтрокаJSON = РатJSON.ОбъектВСтроку(Новый Структура("Ключ", "Значение"));
//
Функция ОбъектВСтроку(Объект, Параметры = Неопределено) Экспорт
	
#Если ВебКлиент Тогда
	ВызватьИсключение "Метод не поддерживается в веб-клиенте";
#Иначе
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	
	Если Параметры = Неопределено ИЛИ НЕ РатКоллекции.ЗначениеСтруктуры(Параметры, "БезПреобразования", Ложь) Тогда
		ПодготовленныеДанные = РатПреобразованияВызовСервера.СериализоватьЗначение(Объект);
	Иначе
		ПодготовленныеДанные = Объект;
	КонецЕсли;
	
	ЗаписатьJSON(Запись, ПодготовленныеДанные);
	
	Возврат Запись.Закрыть();
#КонецЕсли
	
КонецФункции

// Восстанавливает значение из строки JSON.
//
// Параметры:
//   Строка - Строка - Строка JSON.
//
// Возвращаемое значение:
//   Произвольный - Объект, восстановленный из строки JSON.
//
// Пример:
//   Объект = РатJSON.ОбъектИзСтроки("{"Ключ": "Значение"}");
//
Функция ОбъектИзСтроки(Строка) Экспорт
	
#Если ВебКлиент Тогда
	ВызватьИсключение "Метод не поддерживается в веб-клиенте";
#Иначе
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строка);
	Объект = ПрочитатьJSON(Чтение);
	
	Чтение.Закрыть();
	
	//@skip-check constructor-function-return-section
	Возврат Объект;
#КонецЕсли
	
КонецФункции

// Восстанавливает значение из строки JSON, используя Соответствие для объектов.
// Далее пытается преобразовать Соответствие в Структуру, если ключи валидны.
//
// Параметры:
//   Строка - Строка - Строка JSON.
//
// Возвращаемое значение:
//   Произвольный - Объект, восстановленный из строки JSON.
//
Функция ОбъектИзСтрокиСПриведением(Строка) Экспорт
	
#Если ВебКлиент Тогда
	ВызватьИсключение "Метод не поддерживается в веб-клиенте";
#Иначе
	РезультатРазбора = JSONПрочитатьЗначение(Строка, 1);
	Значение = РезультатРазбора.Значение;
	Возврат ПривестиСоответствияВСтруктуры(Значение);
#КонецЕсли
	
КонецФункции

Функция JSONПрочитатьЗначение(СтрокаJSON, Позиция)
	
	Позиция = JSONПропуститьПробелы(СтрокаJSON, Позиция);
	Если Позиция > СтрДлина(СтрокаJSON) Тогда
		Возврат Новый Структура("Значение,Позиция", Неопределено, Позиция);
	КонецЕсли;
	
	Символ = Сред(СтрокаJSON, Позиция, 1);
	
	Если Символ = "{" Тогда
		Возврат JSONПрочитатьОбъект(СтрокаJSON, Позиция + 1);
	ИначеЕсли Символ = "[" Тогда
		Возврат JSONПрочитатьМассив(СтрокаJSON, Позиция + 1);
	ИначеЕсли Символ = """" Тогда
		Возврат JSONПрочитатьСтроку(СтрокаJSON, Позиция + 1);
	ИначеЕсли Сред(СтрокаJSON, Позиция, 4) = "true" Тогда
		Возврат Новый Структура("Значение,Позиция", Истина, Позиция + 4);
	ИначеЕсли Сред(СтрокаJSON, Позиция, 5) = "false" Тогда
		Возврат Новый Структура("Значение,Позиция", Ложь, Позиция + 5);
	ИначеЕсли Сред(СтрокаJSON, Позиция, 4) = "null" Тогда
		Возврат Новый Структура("Значение,Позиция", Неопределено, Позиция + 4);
	Иначе
		Возврат JSONПрочитатьЧисло(СтрокаJSON, Позиция);
	КонецЕсли;
	
КонецФункции

Функция JSONПрочитатьОбъект(СтрокаJSON, Позиция)
	
	Объект = Новый Соответствие;
	Позиция = JSONПропуститьПробелы(СтрокаJSON, Позиция);
	
	Если Позиция <= СтрДлина(СтрокаJSON) И Сред(СтрокаJSON, Позиция, 1) = "}" Тогда
		Возврат Новый Структура("Значение,Позиция", Объект, Позиция + 1);
	КонецЕсли;
	
	Пока Позиция <= СтрДлина(СтрокаJSON) Цикл
		
		Если Сред(СтрокаJSON, Позиция, 1) <> """" Тогда
			ВызватьИсключение "Некорректный JSON: ожидается кавычка";
		КонецЕсли;
		
		РезультатКлюча = JSONПрочитатьСтроку(СтрокаJSON, Позиция + 1);
		Ключ = РезультатКлюча.Значение;
		Позиция = JSONПропуститьПробелы(СтрокаJSON, РезультатКлюча.Позиция);
		
		Если Сред(СтрокаJSON, Позиция, 1) <> ":" Тогда
			ВызватьИсключение "Некорректный JSON: ожидается ':'";
		КонецЕсли;
		
		РезультатЗначения = JSONПрочитатьЗначение(СтрокаJSON, Позиция + 1);
		Объект.Вставить(Ключ, РезультатЗначения.Значение);
		Позиция = JSONПропуститьПробелы(СтрокаJSON, РезультатЗначения.Позиция);
		
		Если Сред(СтрокаJSON, Позиция, 1) = "," Тогда
			Позиция = JSONПропуститьПробелы(СтрокаJSON, Позиция + 1);
			Продолжить;
		ИначеЕсли Сред(СтрокаJSON, Позиция, 1) = "}" Тогда
			Возврат Новый Структура("Значение,Позиция", Объект, Позиция + 1);
		Иначе
			ВызватьИсключение "Некорректный JSON: ожидается '}'";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Значение,Позиция", Объект, Позиция);
	
КонецФункции

Функция JSONПрочитатьМассив(СтрокаJSON, Позиция)
	
	Массив = Новый Массив;
	Позиция = JSONПропуститьПробелы(СтрокаJSON, Позиция);
	
	Если Позиция <= СтрДлина(СтрокаJSON) И Сред(СтрокаJSON, Позиция, 1) = "]" Тогда
		Возврат Новый Структура("Значение,Позиция", Массив, Позиция + 1);
	КонецЕсли;
	
	Пока Позиция <= СтрДлина(СтрокаJSON) Цикл
		
		РезультатЗначения = JSONПрочитатьЗначение(СтрокаJSON, Позиция);
		Массив.Добавить(РезультатЗначения.Значение);
		Позиция = JSONПропуститьПробелы(СтрокаJSON, РезультатЗначения.Позиция);
		
		Если Сред(СтрокаJSON, Позиция, 1) = "," Тогда
			Позиция = JSONПропуститьПробелы(СтрокаJSON, Позиция + 1);
			Продолжить;
		ИначеЕсли Сред(СтрокаJSON, Позиция, 1) = "]" Тогда
			Возврат Новый Структура("Значение,Позиция", Массив, Позиция + 1);
		Иначе
			ВызватьИсключение "Некорректный JSON: ожидается ']'";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Значение,Позиция", Массив, Позиция);
	
КонецФункции

Функция JSONПрочитатьСтроку(СтрокаJSON, Позиция)
	
	Результат = "";
	
	Пока Позиция <= СтрДлина(СтрокаJSON) Цикл
		Символ = Сред(СтрокаJSON, Позиция, 1);
		
		Если Символ = """" Тогда
			Возврат Новый Структура("Значение,Позиция", Результат, Позиция + 1);
		ИначеЕсли Символ = "\" Тогда
			Позиция = Позиция + 1;
			Экранированный = Сред(СтрокаJSON, Позиция, 1);
			
			Если Экранированный = """" Тогда
				Результат = Результат + """";
			ИначеЕсли Экранированный = "\" Тогда
				Результат = Результат + "\";
			ИначеЕсли Экранированный = "/" Тогда
				Результат = Результат + "/";
			ИначеЕсли Экранированный = "b" Тогда
				Результат = Результат + Символ(8);
			ИначеЕсли Экранированный = "f" Тогда
				Результат = Результат + Символ(12);
			ИначеЕсли Экранированный = "n" Тогда
				Результат = Результат + Символ(10);
			ИначеЕсли Экранированный = "r" Тогда
				Результат = Результат + Символ(13);
			ИначеЕсли Экранированный = "t" Тогда
				Результат = Результат + Символ(9);
			ИначеЕсли Экранированный = "u" Тогда
				Код = Число("16#" + Сред(СтрокаJSON, Позиция + 1, 4));
				Результат = Результат + Символ(Код);
				Позиция = Позиция + 4;
			Иначе
				Результат = Результат + Экранированный;
			КонецЕсли;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
		
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Возврат Новый Структура("Значение,Позиция", Результат, Позиция);
	
КонецФункции

Функция JSONПрочитатьЧисло(СтрокаJSON, Позиция)
	
	Начало = Позиция;
	Пока Позиция <= СтрДлина(СтрокаJSON) Цикл
		Символ = Сред(СтрокаJSON, Позиция, 1);
		Если Найти("0123456789+-.eE", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	СтрокаЧисла = Сред(СтрокаJSON, Начало, Позиция - Начало);
	Попытка
		Значение = Число(СтрокаЧисла);
	Исключение
		Значение = СтрокаЧисла;
	КонецПопытки;
	
	Возврат Новый Структура("Значение,Позиция", Значение, Позиция);
	
КонецФункции

Функция JSONПропуститьПробелы(СтрокаJSON, Позиция)
	
	Пока Позиция <= СтрДлина(СтрокаJSON) Цикл
		Символ = Сред(СтрокаJSON, Позиция, 1);
		Если Символ = " " Или Символ = Символ(9) Или Символ = Символ(10) Или Символ = Символ(13) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Возврат Позиция;
	
КонецФункции

Функция ПривестиСоответствияВСтруктуры(Значение)
	
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		
		МожноСтруктуру = Истина;
		Для Каждого Элемент Из Значение Цикл
			Если НЕ КлючДопустимДляСтруктуры(Элемент.Ключ) Тогда
				МожноСтруктуру = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если МожноСтруктуру Тогда
			Результат = Новый Структура;
			Для Каждого Элемент Из Значение Цикл
				Результат.Вставить(Элемент.Ключ, ПривестиСоответствияВСтруктуры(Элемент.Значение));
			КонецЦикла;
			Возврат Результат;
		Иначе
			Результат = Новый Соответствие;
			Для Каждого Элемент Из Значение Цикл
				Результат.Вставить(Элемент.Ключ, ПривестиСоответствияВСтруктуры(Элемент.Значение));
			КонецЦикла;
			Возврат Результат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПривестиСоответствияВСтруктуры(Элемент));
		КонецЦикла;
		Возврат Результат;
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция КлючДопустимДляСтруктуры(Имя)
	
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрИмя = НРег(Строка(Имя));
	ДопустимыеБуквы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	ДопустимыеПервый = ДопустимыеБуквы + "_";
	ДопустимыеОстальные = ДопустимыеБуквы + "0123456789_";
	
	Если Найти(ДопустимыеПервый, Лев(СтрИмя, 1)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 2 По СтрДлина(СтрИмя) Цикл
		Символ = Сред(СтрИмя, Индекс, 1);
		Если Найти(ДопустимыеОстальные, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, является ли переданный тип примитивным типом JSON.
//
// Параметры:
//   Тип - Тип - Тип для проверки.
//
// Возвращаемое значение:
//   Булево - Истина, если тип является примитивным типом JSON (Строка, Число, Булево, Неопределено).
//
// Пример:
//   Если РатJSON.ЭтоПримитивныйТипJSON(Тип("Строка")) Тогда ...
//
Функция ЭтоПримитивныйТипJSON(Тип) Экспорт
	
	ПримитивныеТипы = Новый ОписаниеТипов("Строка, Число, Булево, Неопределено");
	
	Возврат ПримитивныеТипы.СодержитТип(Тип);
	
КонецФункции

#КонецОбласти
